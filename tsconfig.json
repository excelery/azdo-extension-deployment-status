{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "node",
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "target": "ES2019",
    "rootDir": "src/",
    "outDir": "dist/",
    "jsx": "react",
    "lib": [
      "es2019",
      "dom",
      "es2015.iterable"
    ],
    "types": [
      "react",
      "node"
    ],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "out",
    "test-results"
  ],
  "include": [
    "src/**/*"
  ]
}
